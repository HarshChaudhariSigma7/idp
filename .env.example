# Gemini API key (server only, never shipped to the browser). Free key: aistudio.google.com/apikey
GEMINI_API_KEY=
# Set SERENO_LLM_BACKEND=anthropic to use Claude instead, with ANTHROPIC_API_KEY below.
# SERENO_LLM_BACKEND=anthropic
# ANTHROPIC_API_KEY=
# 32-byte AES key, base64. Production: load from KMS / secret manager, never commit.
# python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
SERENO_MASTER_KEY_B64=
SERENO_ENV=dev
SERENO_DATABASE_URL=sqlite:///./var/sereno.db
SERENO_DATA_DIR=./var/data
SERENO_COOKIE_SECURE=false
SERENO_REVIEW_SLA_MINUTES=240
SERENO_QA_SAMPLE_RATE=0.05
